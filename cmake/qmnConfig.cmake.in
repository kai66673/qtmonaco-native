@PACKAGE_INIT@

# The exported targets speak plain Qt: Core/Gui/Widgets/Network usage
# requirements must exist before qmnTargets.cmake is read (its
# INTERFACE_LINK_LIBRARIES name Qt6::* imported targets; Network joins with
# the M8 qmn::protocol layer, qt6-base is already a CI/install dep).
include(CMakeFindDependencyMacro)
find_dependency(Qt6 6.6 REQUIRED COMPONENTS Core Gui Widgets Network)

include("${CMAKE_CURRENT_LIST_DIR}/qmnTargets.cmake")

check_required_components(qmn)
